# Set these in the server environment. This file is not loaded automatically.
GITHUB_TOKEN=
# Interactive GitHub sign-in (device flow). Use a GitHub App with read-only permissions
# (Contents, Pull requests, Metadata) and "Enable Device Flow" checked. No client secret needed.
GITHUB_CLIENT_ID=
# Only for a classic OAuth App: 'repo' reads private repositories. GitHub Apps ignore this.
GITHUB_OAUTH_SCOPE=
GITLAB_TOKEN=
AZURE_DEVOPS_TOKEN=
# Entra app registration (public client/device flow) for interactive Azure login.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=organizations
# Alternative pre-acquired Entra bearer token for non-interactive deployments.
AZURE_DEVOPS_BEARER_TOKEN=
BITBUCKET_TOKEN=
# For Bitbucket API tokens, also set the account email (Basic auth).
BITBUCKET_EMAIL=
# Required before exposing private reviews on a shared network.
REVIEW_HELPER_ACCESS_TOKEN=
# Persistent local SQLite. Vercel uses /tmp unless overridden.
REVIEW_HELPER_DB_PATH=.review-helper/reviews.sqlite3
# Jira Cloud: only this exact configured site receives Jira credentials.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Required for publishing an MCP App. One owned HTTPS origin, no path.
MCP_APP_DOMAIN=
